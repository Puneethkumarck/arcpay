# Identity service environment template. Copy to `.env` (gitignored) and fill in.
# Secrets (PLATFORM_WALLET_PRIVATE_KEY, CIRCLE_*, SERVICE_AUTH_TOKEN) must NEVER be committed.
# Load before running: `set -a; source .env; set +a; ./gradlew :identity:identity:bootRun`

# --- On-chain AgentRegistry (Arc testnet) ---
# Deployed contract address is recorded in identity/identity/contracts/DEPLOY.md
AGENT_REGISTRY_ADDRESS=
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network
# Raw private key of the registrar wallet. Export from your keystore — never commit:
#   cast wallet decrypt-keystore platform
PLATFORM_WALLET_PRIVATE_KEY=

# --- Circle (wallet provisioning) ---
CIRCLE_API_KEY=
CIRCLE_WALLET_SET_ID=
CIRCLE_ENTITY_SECRET=

# --- Service auth ---
SERVICE_AUTH_TOKEN=

# --- Infra (defaults shown; override if your local setup differs) ---
DB_USERNAME=arcpay
DB_PASSWORD=arcpay
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
TEMPORAL_ADDRESS=localhost:7233
